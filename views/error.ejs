<%- include('partials/header') %>

<main class="main-content">
  <div class="panel text-center py-10">
    <div style="font-size: 48px; margin-bottom: 12px;">⚠️</div>
    <h2 class="section-title">Database Operation Error</h2>
    <p class="text-muted" style="max-width: 600px; margin: 10px auto;">
      An error occurred while communicating with the database. Please review the diagnostic details below:
    </p>
    <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 16px; border-radius: 8px; font-family: monospace; max-width: 700px; margin: 20px auto; text-align: left;">
      <%= error %>
    </div>
    <div class="mt-6">
      <a href="/" class="btn btn-primary">Return to Dashboard</a>
      <button class="btn btn-secondary" onclick="openCloudModal()">Configure Cloud Database</button>
    </div>
  </div>
</main>

<%- include('partials/footer') %>

