# ============================================================================
# Environment Variables Example - Cloud PostgreSQL Connection
# ============================================================================

# Cloud PostgreSQL Connection URL (e.g., from Neon.tech, Render, Supabase)
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Web Server Port (Defaults to 3000 locally, cloud hosts set this automatically)
PORT=3000

# SSL Mode (Set to true or require for cloud databases; false for plain local postgres)
DB_SSL=true

